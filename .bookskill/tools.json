{
  "version": 1,
  "source": "docs/GROK_EXECUTION_SPEC.md section 4.2",
  "policy": "fail-closed",
  "allowed": [
    { "id": "read_project_docs", "description": "读取项目文档" },
    { "id": "read_tasks", "description": "读取任务" },
    { "id": "create_task", "description": "创建任务" },
    { "id": "update_task", "description": "更新任务" },
    { "id": "assign_task", "description": "分配任务负责人" },
    { "id": "decompose_task", "description": "分解任务" },
    { "id": "create_isolated_branch", "description": "创建隔离分支或 worktree" },
    { "id": "modify_branch_files", "description": "在隔离分支上修改文件" },
    { "id": "run_tests", "description": "运行测试" },
    { "id": "create_pull_request", "description": "创建 PR（远端未连接时必须 BLOCKED，不得伪称成功）" },
    { "id": "read_ci_results", "description": "读取 CI 结果（远端未连接时必须 BLOCKED，不得伪称成功）" },
    { "id": "generate_report", "description": "生成测试或交接报告" },
    { "id": "write_requirements", "description": "编写页面需求与用户故事" },
    { "id": "write_acceptance_criteria", "description": "编写验收条件" },
    { "id": "write_technical_decision", "description": "记录技术决策（ADR）" },
    { "id": "review_upstream", "description": "审查上游集成" },
    { "id": "security_review", "description": "安全与隐私检查" },
    { "id": "veto_pass", "description": "阻止任务通过独立 QA" },
    { "id": "build_release_candidate", "description": "构建发布候选" },
    { "id": "sign_build", "description": "为发布候选签名（非正式生产发布）" },
    { "id": "write_release_notes", "description": "撰写发布说明" }
  ],
  "denied": [
    { "id": "merge_main", "description": "合并主分支", "reason": "主分支始终受保护。不得实现可用的合并 main 路径。" },
    { "id": "push_main", "description": "直接推送主分支", "reason": "禁止直接推送主分支。" },
    { "id": "merge_own_pr", "description": "直接合并自己的 PR", "reason": "禁止直接合并自己的 PR。" },
    { "id": "production_release", "description": "生产发布", "reason": "生产发布始终需人工批准。不得实现可用的发布生产路径。" },
    { "id": "read_production_secrets", "description": "读取生产密钥", "reason": "禁止读取生产密钥；不得在日志中留下明文。" },
    { "id": "delete_production_data", "description": "删除线上数据", "reason": "禁止删除线上数据。" },
    { "id": "access_real_user_books", "description": "访问真实用户书籍", "reason": "禁止访问真实用户书籍。" },
    { "id": "bypass_payment_or_license", "description": "绕过支付或授权系统", "reason": "禁止绕过支付或授权系统。" }
  ],
  "aliases": {
    "merge_to_main": "merge_main",
    "git_merge_main": "merge_main",
    "merge_to_master": "merge_main",
    "合并主分支": "merge_main",
    "push_to_main": "push_main",
    "git_push_main": "push_main",
    "直接推送主分支": "push_main",
    "merge_self_pr": "merge_own_pr",
    "直接合并自己的PR": "merge_own_pr",
    "publish_production": "production_release",
    "release_production": "production_release",
    "publish_prod": "production_release",
    "发布生产": "production_release",
    "read_prod_secrets": "read_production_secrets",
    "read_prod_keys": "read_production_secrets",
    "读取生产密钥": "read_production_secrets",
    "delete_online_data": "delete_production_data",
    "delete_prod_data": "delete_production_data",
    "删除线上数据": "delete_production_data",
    "access_user_books": "access_real_user_books",
    "bypass_license": "bypass_payment_or_license",
    "bypass_payment": "bypass_payment_or_license"
  }
